# Same-host in-memory read cache over public-mirror.
#
# Discovers regional databases from GET /v1/mirrors on the local
# public-mirror listen address, waits until each is connectivity=live,
# then opens a v2 BSATN subscription per region. Serves the HTTP/protobuf
# read API (plus the public dim-buildings WS) on 127.0.0.1:8089.
[Unit]
Description=relay-cache (public-mirror read cache)
After=network-online.target public-mirror.service
Wants=network-online.target
Wants=public-mirror.service

[Service]
Type=simple
User=relay
Group=relay
ExecStart=/srv/relay/bitcraft-relay/target/release/relay-cache \
    --bind 127.0.0.1:8089 \
    --mirror-host 127.0.0.1:3000 \
    --schema-db bitcraft-live-14
# Diagnosing a hung SubscribeApplied: append --debug to ExecStart (or set
# RELAY_CACHE_DEBUG=1). Heartbeats every 5s while waiting on bulk load.
WorkingDirectory=/srv/relay/bitcraft-relay
Environment="PATH=/srv/relay/.local/bin:/srv/relay/.cargo/bin:/usr/local/bin:/usr/bin:/bin"
Environment="RUST_LOG=relay_cache=info"
Restart=on-failure
RestartSec=5s
# Initial SubscribeApplied for inventory-heavy regions can take minutes.
TimeoutStartSec=0
TimeoutStopSec=30s
# Soft ceiling matching the binary default (4 GiB); OS OOM is the hard stop.
MemoryHigh=4G

[Install]
WantedBy=multi-user.target

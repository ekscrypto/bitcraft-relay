# Same-host in-memory read cache over the relay fleet.
#
# Subscribes to each regional frontend on loopback (v2), holds claim /
# building / inventory / player / housing / craft / hexite / storage-log
# tables in columnar memory, and serves the HTTP/protobuf read API
# (plus the public dim-buildings WS) on 127.0.0.1:8089.
#
# Discovers regions from public-mirror /v1/mirrors (drop-in) and/or
# legacy relay-bc* units. Schema is fetched once at startup from any
# live regional frontend (see RELAY_CACHE_SCHEMA_*).
[Unit]
Description=spacetimedb-relay in-memory read cache
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=relay
Group=relay
# Schema host/db come from Environment / cutover drop-in — do not hardcode
# CLI --schema-* here (clap CLI flags override env and break cutover).
ExecStart=/srv/relay/bitcraft-relay/target/release/relay-cache \
    --bind 127.0.0.1:8089 \
    --unit-dir /etc/systemd/system
# Diagnosing a hung SubscribeApplied: append --debug to ExecStart (or set
# RELAY_CACHE_DEBUG=1). Heartbeats every 5s while waiting on bulk load.
WorkingDirectory=/srv/relay/bitcraft-relay
Environment="PATH=/srv/relay/.local/bin:/srv/relay/.cargo/bin:/usr/local/bin:/usr/bin:/bin"
# Full public-mirror fleet (native ports): cutover drop-in sets
# RELAY_CACHE_MIRRORS_URL to the comma-separated sidecar list and
# RELAY_CACHE_SCHEMA_* to a live bitcraft-live-N instance.
Environment="RELAY_CACHE_MIRRORS_URL="
Environment="RELAY_CACHE_MIRROR_WS_HOST="
Environment="RELAY_CACHE_SCHEMA_HOST=127.0.0.1:3007"
Environment="RELAY_CACHE_SCHEMA_DB=bitcraft-live-7"
Environment="RUST_LOG=relay_cache=info"
# App soft alarm for /cache-health ready=false (not a load shedder).
# Keep in sync with MemoryHigh below.
Environment="RELAY_CACHE_MEM_CEILING_BYTES=8589934592"
Restart=on-failure
RestartSec=5s
# Initial SubscribeApplied for inventory-heavy regions can take minutes.
TimeoutStartSec=0
TimeoutStopSec=30s
# Soft ceiling; full-fleet ingest is heavier than the old hybrid layout.
MemoryHigh=8G

[Install]
WantedBy=multi-user.target

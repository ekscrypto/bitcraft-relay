# One-process BitCraft mirror + embedded read cache (spacetimedb-bitcraft-mirror).
#
# Single process: 10 upstream mirrors (BitCraft 1.0 release), the read cache
# fed in-process (--bitcraft-cache), one WS listen, one status sidecar.
# Upstream moved from Early Access (bitcraft-early-access.spacetimedb.com,
# bitcraft-live-*) to the official release servers on 2026-11: 1.0 has 9
# player-buildable regions (7, 8, 9, 12, 13, 14, 17, 18, 19) + global.
# Region 10 is not buildable (near-zero upstream activity as of 2026-11-10);
# the initial 1.0 cutover wrongly mirrored it instead of region 7 (Virexal).
# The EA2 unit file is archived at tools/archive/bitcraft-mirror.service.ea2.
#
# Loopback layout (see bitcraft-relay/PORTS.md):
#   127.0.0.1:3100  WS/HTTP for clients   — nginx 3000–3025 proxies here
#   127.0.0.1:3130  isolated /v1/mirrors  — main port + 30 (offset convention)
#   127.0.0.1:8090  embedded cache API    — nginx cache paths proxy here
#
# Upstream auth: same EnvironmentFile as the fleet (`RELAY_UPSTREAM_TOKEN=…`,
# a token env the standalone resolves natively). JWT keys: the same spacetime
# CLI keypair as the public-mirror units.
[Unit]
Description=spacetimedb-bitcraft-mirror (one-process mirror + embedded cache)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=relay
Group=relay
EnvironmentFile=-/etc/relay/upstream.env
ExecStart=/srv/relay/spacetimedb-bitcraft-mirror/target/release/spacetimedb-standalone start \
    --data-dir /var/lib/relay/bitcraft-mirror \
    --listen-addr 127.0.0.1:3100 \
    --mirror-status-listen-addr 127.0.0.1:3130 \
    --jwt-key-dir /srv/relay/.config/spacetime \
    --public-mirror-v1 \
    --non-interactive \
    --mirror-subscribe-concurrency 1 \
    --bitcraft-cache \
    --roads-cache \
    --cache-bind 127.0.0.1:8090 \
    --cache-mem-ceiling-bytes 60129542144 \
    --mirror wss://bitcraft-release.spacetimedb.com/idc-global \
    --mirror wss://bitcraft-release.spacetimedb.com/idc-7 \
    --mirror wss://bitcraft-release.spacetimedb.com/idc-8 \
    --mirror wss://bitcraft-release.spacetimedb.com/idc-9 \
    --mirror wss://bitcraft-release.spacetimedb.com/idc-12 \
    --mirror wss://bitcraft-release.spacetimedb.com/idc-13 \
    --mirror wss://bitcraft-release.spacetimedb.com/idc-14 \
    --mirror wss://bitcraft-release.spacetimedb.com/idc-17 \
    --mirror wss://bitcraft-release.spacetimedb.com/idc-18 \
    --mirror wss://bitcraft-release.spacetimedb.com/idc-19
WorkingDirectory=/srv/relay/spacetimedb-bitcraft-mirror
Environment="PATH=/srv/relay/.local/bin:/srv/relay/.cargo/bin:/usr/local/bin:/usr/bin:/bin"
Environment="RUST_LOG=spacetimedb=info,public_mirror=info,relay_cache=info"
# No rolling stdb.log in the data dir: journald already captures stdout, and
# the file double-writes every line to the slow array (attempt #4 post-mortem).
Environment="SPACETIMEDB_DISABLE_DISK_LOGGING=1"
Restart=on-failure
RestartSec=5s
# Full-fleet cold seed measured ~6 minutes; allow much longer on a loaded host.
TimeoutStartSec=0
TimeoutStopSec=60s
# Soft ceiling. EA2 production steady state was ~35–37 GiB without roads
# (2026-08-17, attempt #5); --roads-cache added ~4 GiB (~289 MiB/region × 14).
# The original 32G cap was set from the LOCAL soak (~26 GiB peak) and put green
# permanently over memory.high in production — every charge was memcg-throttled
# (154k+ throttle events, tokio workers D-stalled in mem_cgroup_handle_over_high).
# Raised to 48G for the one-process cutover (attempt #5); 56G after roads.
# Kept at 56G for the 1.0 cutover (10 mirrors, fresh world) — re-measure as the
# release world fills; the ram-guard unit (MemAvailable < 2 GiB) is the backstop.
MemoryHigh=56G

[Install]
WantedBy=multi-user.target

# Host-managed site: /etc/nginx/sites-available/relay-frontends
#
# Keep one `listen` per public port in 3000–3025 (IPv4 + IPv6) with the
# existing Let's Encrypt cert for relay.bitcraftsync.app. Change only the
# upstream: every port proxies to the single public-mirror loopback listen.
#
# Before (per-region relay):
#   proxy_pass http://127.0.0.1:$server_port;
# After (public-mirror):
#   proxy_pass http://127.0.0.1:3000;
#
# Dark-band IO guard (2026-08-17, MULTI-MIRROR-UPSTREAM-RESETS.md attempt
# #4 — nginx log writeback was the 180 MB burst that starved the mirror's
# page faults on the ~3 MB/s array). Keep these when editing:
#   - /etc/nginx/nginx.conf http{}:
#       access_log /var/log/nginx/access.log combined buffer=64k flush=5s;
#     (batches log writes instead of one write(2) per request)
#   - inside this file's server{} (the whole WS band is ONE server block):
#       error_log /var/log/nginx/error.log crit;
#     (suppresses [error]-level upstream-connect noise while the band is
#      dark during cutover/rollback; access_log still records 502 codes)
#   - /etc/logrotate.d/nginx: daily, rotate 14, nocompress — no gzip pass
#     over ~6 GB/day of logs on the slow array; retention stays bounded.

# Inside each `server { listen …:30NN ssl; … }` block:
location / {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
}

# Clients:
#   wss://relay.bitcraftsync.app:<any-3000-3025>/v1/database/bitcraft-live-N/subscribe
#   https://relay.bitcraftsync.app:<port>/v1/database/bitcraft-live-N/schema?version=9
#   http://127.0.0.1:3030/v1/mirrors   (isolated sidecar; responsive during seed)
#   http://127.0.0.1:3000/v1/mirrors   (main server; may hang while seeding)
